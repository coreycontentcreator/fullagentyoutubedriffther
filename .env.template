# Environment Variables Template
# Copy this file to .env and fill in your API keys

# ==================== Required API Keys ====================

# Anthropic API Key (Required)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube Data API Key (Optional - for video analysis features)
# Get your key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# ==================== Optional API Keys ====================

# OpenAI API Key (Optional - for embeddings and alternative generation)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ==================== Database Configuration ====================

# Vector Database (if using hosted solution)
# PINECONE_API_KEY=your_pinecone_key_here
# PINECONE_ENVIRONMENT=your_pinecone_environment_here

# QDRANT_URL=your_qdrant_url_here
# QDRANT_API_KEY=your_qdrant_key_here

# ==================== Research Database APIs (Optional) ====================

# JSTOR API (for enhanced research capabilities)
# JSTOR_API_KEY=your_jstor_key_here

# Semantic Scholar API
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here

# CrossRef API (usually no key required)
# CROSSREF_EMAIL=your_email@example.com

# ==================== Additional Configuration ====================

# Environment (development, staging, production)
ENVIRONMENT=development

# Log Level Override (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Project Root (usually auto-detected)
# PROJECT_ROOT=/path/to/project
