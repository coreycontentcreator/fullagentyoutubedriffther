# Environment Variables for Research System
# Copy this file to .env and fill in your API keys

# REQUIRED: Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OPTIONAL: Research Source API Keys
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here
JSTOR_API_KEY=your_jstor_key_here
CROSSREF_API_KEY=your_crossref_key_here
PUBMED_API_KEY=your_pubmed_key_here
ARXIV_API_KEY=not_required
OPENALEX_EMAIL=your.email@example.com
